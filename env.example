# Clé Riot (developer.riotgames.com). Une clé de développement expire après 24 h.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Région par défaut : euw1, eun1, tr1, ru, me1, na1, br1, la1, la2, kr, jp1, oc1, sg2, tw2, vn2
DEFAULT_PLATFORM=euw1

PORT=3000

# Facultatif
# HOST=127.0.0.1          # mets 0.0.0.0 pour ouvrir le site sur ton réseau local
# DDRAGON_LANG=fr_FR      # langue des données du jeu (en_US, es_ES, de_DE…)
# RIOT_RATE_LIMITS=20:1,100:120   # limites de ta clé (requêtes:secondes)

# DEMO=0 désactive le bandeau de démonstration et autorise les analyses
DEMO=0

# Annuaire automatique des joueurs pros (reconnaissance dans les parties et sur les profils).
# Mise à jour toutes les PRO_DIR_HOURS heures (0 = désactivé). Les sources ont des valeurs par défaut.
PRO_DIR_HOURS=24
# CONTACT_EMAIL=ton@email (envoyé dans l'en-tête User-Agent, demandé par les sources publiques)

# Streamers sans « ttv » dans le pseudo : reconnus via Twitch (chaîne au même nom, partenaire
# ou affiliée, qui diffuse League of Legends). Clés gratuites sur le portail développeur Twitch.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Mot de passe du bouton « Ajouter 150 parties » de l'accueil (à changer sur l'hébergeur).
ADMIN_PASSWORD=riot123

# Relevé automatique des rangs Maître+ (peaks et rangs par saison), en heures (0 = désactivé).
RANK_SNAPSHOT_HOURS=2
# RANK_SNAPSHOT_PLATFORMS=euw1,kr,na1

# ---------- Publicité (Google AdSense) ----------
# Laisser vide = aucune publicité, aucun script Google, CSP stricte.
# ID éditeur AdSense (Compte > Informations sur le compte), format ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT=
# ID des blocs d'annonces (Annonces > Par bloc d'annonces > Display), 10 chiffres
# Bandeau en bas de chaque page
ADSENSE_SLOT_BANNER=
# Bloc dans la colonne gauche du profil joueur
ADSENSE_SLOT_SIDEBAR=
# Bandeau dans la page champion (sous matchups / synergies)
ADSENSE_SLOT_INCONTENT=
# 1 = annonces de test (aucun revenu, aucun clic compté) : à utiliser avant validation
ADSENSE_TEST=0
# Lignes supplémentaires pour /ads.txt (autres régies), séparées par \n
ADS_TXT_EXTRA=
