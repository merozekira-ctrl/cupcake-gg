# Clé Riot (developer.riotgames.com). Une clé de développement expire après 24 h.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Région par défaut : euw1, eun1, tr1, ru, me1, na1, br1, la1, la2, kr, jp1, oc1, sg2, tw2, vn2
DEFAULT_PLATFORM=euw1

PORT=3000

# Facultatif
# HOST=127.0.0.1          # mets 0.0.0.0 pour ouvrir le site sur ton réseau local
# DDRAGON_LANG=fr_FR      # langue des données du jeu (en_US, es_ES, de_DE…)
# RIOT_RATE_LIMITS=20:1,100:120   # limites de ta clé (requêtes:secondes)
